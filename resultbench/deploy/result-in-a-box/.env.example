# Copy to .env and fill in before result day.
# Release time in Unix milliseconds, e.g. for 13:00 IST on 13 May 2027:
#   date -d "2027-05-13 13:00 +0530" +%s000
RELEASE_AT_MS=
# Folder that contains results.csv
RESULTS_CSV_DIR=./sample
WEB_PORT=8080
# How long Nginx may serve a replaced file after a correction (seconds).
OFC_VALID=10s
# Browser/CDN cache lifetime for a result (seconds). Keep short if corrections are expected.
RESULT_MAX_AGE=60
RATE_PER_IP=5r/s
# Waiting room (only with --profile queue)
QUEUE_SECRET=
QUEUE_ADMIT_RATE=500
QUEUE_POLICY=random
QUEUE_POLL=10s
QUEUE_PORT=8090
